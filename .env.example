# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medicine-reminder?retryWrites=true&w=majority

# JWT Secret for admin authentication (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin default password (used during initial database seed)
ADMIN_DEFAULT_PASSWORD=admin123

# Seed secret - required to call /api/admin/seed endpoint
# Set this to any secret string, used once during initial setup
SEED_SECRET=your-seed-secret-here

# Optional: Node environment
NODE_ENV=development
